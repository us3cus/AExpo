# Environment Configuration for AExpo
# Copy this file to .env and configure the values

# Node.js Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# AWS S3 Configuration (if using for file uploads)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket-name

# Database Configuration (configure based on your backend)
# DATABASE_URL=postgresql://user:password@localhost:5432/aexpo
# MONGODB_URI=mongodb://localhost:27017/aexpo

# API Configuration
# API_BASE_URL=http://localhost:3000/api

# Security
# JWT_SECRET=your-secret-key-here
# SESSION_SECRET=your-session-secret-here

# Application Settings
# APP_NAME=AExpo
# APP_URL=http://localhost:3000

# Logging
# LOG_LEVEL=info
